# Site canonical URL (Next.js)
NEXT_PUBLIC_SITE_URL=https://tech-agnostic.com

# Site canonical URL (Astro blog)
PUBLIC_SITE_URL=https://tech-agnostic.com

# Contact email
NEXT_PUBLIC_CONTACT_EMAIL=hello@tech-agnostic.com

# Lead form endpoint (optional: Basin, Formspree, n8n webhook, etc.)
# If left empty, the contact form falls back gracefully to a prefilled mailto link.
NEXT_PUBLIC_FORM_ENDPOINT=
