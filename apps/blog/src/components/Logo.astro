---
/**
 * Mirror of apps/web/components/Logo.tsx — the Offset Delta, same 32×32
 * geometry per BRAND.md §2.2. These two files are the only places the mark is
 * drawn; keep them in step.
 */
interface Props {
  size?: number;
  /** Unique gradient id — required if more than one mark is on a page. */
  idSuffix?: string;
}
const { size = 30, idSuffix = 'a' } = Astro.props;
const gid = `dv-aurora-${idSuffix}`;
---

<span class="inline-flex items-center gap-2.5">
  <svg
    width={size}
    height={size}
    viewBox="0 0 32 32"
    fill="none"
    aria-hidden="true"
    focusable="false"
  >
    <defs>
      <linearGradient id={gid} x1="3.5" y1="27" x2="28.5" y2="4" gradientUnits="userSpaceOnUse">
        <stop offset="0" stop-color="var(--color-mint)"></stop>
        <stop offset="0.52" stop-color="var(--color-cyan)"></stop>
        <stop offset="1" stop-color="var(--color-violet)"></stop>
      </linearGradient>
    </defs>
    <g fill={`url(#${gid})`}>
      <polygon points="18.2,4 25.2,16.8 11.2,16.8"></polygon>
      <polygon points="7.5,19.6 24.5,19.6 28.5,27 3.5,27"></polygon>
    </g>
  </svg>
  <span
    class="font-display font-bold text-frost"
    style={`font-size:${size * 0.55}px; letter-spacing:-0.025em;`}
  >
    deltavantis
  </span>
</span>
