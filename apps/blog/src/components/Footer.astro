---
import Logo from './Logo.astro';
const year = new Date().getFullYear();
---

<footer class="band-aurora mt-24">
  <div class="container-dv py-14">
    <div
      class="flex flex-col gap-10 md:flex-row md:items-start md:justify-between"
    >
      <div>
        <Logo size={28} idSuffix="footer" />
        <p class="mt-4 max-w-xs text-sm text-mist">
          Independent IT consulting. No vendor commission, no stack religion, no
          90-page decks.
        </p>
      </div>

      <nav aria-label="Footer" class="flex flex-wrap gap-x-8 gap-y-3">
        {
          [
            { label: 'Services', href: '/#services' },
            { label: 'Method', href: '/#method' },
            { label: 'Pricing', href: '/#pricing' },
            { label: 'Contact', href: '/contact' },
            { label: 'RSS', href: '/blog/rss.xml' },
          ].map((link) => (
            <a
              href={link.href}
              class="text-sm text-mist transition-colors duration-150 ease-out hover:text-white"
            >
              {link.label}
            </a>
          ))
        }
      </nav>
    </div>

    <div
      class="mt-12 flex flex-col gap-3 border-t border-edge-2 pt-6 sm:flex-row sm:items-center sm:justify-between"
    >
      <p class="text-xs text-mist">
        © {year} Deltavantis. All rights reserved.
      </p>
      <a
        href="/privacy"
        class="text-xs text-mist transition-colors duration-150 ease-out hover:text-white"
      >
        Privacy
      </a>
    </div>
  </div>
</footer>
